# ---------- MongoDB Atlas ----------
# Atlas -> Connect -> Drivers -> copy the connection string and put your user/password in it.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.uvmsnhs.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# If your network blocks SRV DNS lookups (error: querySrv ECONNREFUSED), use the
# "Legacy URI String" from Atlas instead (starts with mongodb:// and lists the 3 shard hosts).
MONGODB_DB=homeopathy_clinic

# ---------- Admin portal ----------
# The single admin account is created in MongoDB on first run. These only matter for that first seed.
ADMIN_USERNAME=admin@123
ADMIN_PASSWORD=pass@123
# Long random string used to sign admin login tokens (required)
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# ---------- Doctor / app ----------
DOCTOR_EMAIL=tejasmhaske047@gmail.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Google Calendar / Meet ----------
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: set after the one-time doctor authorization
GOOGLE_REFRESH_TOKEN=

# ---------- Razorpay (public key id) ----------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
